# Local API server. The production host must provide a persistent DB_PATH volume.
NODE_ENV=development
PORT=3000
DB_PATH=./storage/store.sqlite

# Local first-run admin account. Change both values before a public deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234567
SESSION_SECRET=123456789101112

# Configure Cloudinary and EmailJS from Admin > Store settings after signing in.
