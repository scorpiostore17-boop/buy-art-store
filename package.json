{
  "name": "buy-art-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"},
  "scripts": {
    "dev": "concurrently -k \"npm:api:dev\" \"npm:client:dev\"",
    "api:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "start": "node server/index.js",
    "predeploy": "npm run build",
    "deploy:check": "npm run build",
    "admin:reset-password": "node server/reset-admin-password.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
  
}
 